# The product documentation is not written here: `make docs` (or the workflow)
# copies it out of digline/digline before every build. Nothing under this path
# is ever committed — the source of truth is the other repository.
/docs/product/

/site/

# Written by tools/sync-docs.sh, read by tools/hooks/seo.py: when each page
# under docs/product/ last changed, according to digline/digline's history.
/.lastmod.tsv

# Written by tools/sync-docs.sh, read by tools/hooks/sources.py: rule 1 of
# digline's AGENTS.md at the latest release tag, with the tag and its commit,
# which the quotation on /agents/ is held to. Regenerated by every sync, like
# the manifest above, so it can never disagree with the checkout it came from.
/.agents-rule.json

# Written by tools/sync-docs.sh only when SYNC_UNRELEASED=1 told it to copy from
# a checkout it was not allowed to check, read by tools/check-source.sh: the one
# thing standing between a local preview of an unreleased page and the site.
/.sync-preview

/.venv/
__pycache__/
.DS_Store

# Only ever present in CI: the digline checkout the docs are copied out of.
/_digline/
